{
  "name": "bagarre",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run typecheck build",
    "build:bin": "turbo run build:bin",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "smoke": "turbo run smoke",
    "e2e": "turbo run e2e",
    "maps:validate": "turbo run maps:validate",
    "start": "bun run --cwd apps/server start"
  },
  "devDependencies": {
    "oxlint": "^1.85.0",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  }
}
