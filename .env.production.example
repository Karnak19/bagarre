# Production variables for docker-compose.yaml. Copy to .env.production.local
# (git-ignored) for a local run, or fill them in Coolify's environment page.
#
#   docker compose --env-file .env.production.local \
#     -f docker-compose.yaml -f docker-compose.local.yaml up --build

# --- Client build args (public: they end up in the browser bundle) -------------
# Where the browser finds the game server. A path means "this same origin":
# the client's Caddy proxies it to the server container. Leave as is.
VITE_SERVER_URL=/colyseus

# --- Database ---------------------------------------------------------------------
# Password of the `db` service's Postgres user (the server's DATABASE_URL is
# built from it in docker-compose.yaml). Hex, so it needs no escaping in a URL.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Game server (runtime) -------------------------------------------------------
# The site's public origin, no trailing slash. The server builds the password
# reset links (PUBLIC_URL/reset-password?token=...) and the Discord redirect
# (PUBLIC_URL/colyseus/auth/provider/discord/callback) from it. Required.
PUBLIC_URL=https://ghj9pktfasrpthjvvpg2gehp.big-server.basile.vernouillet.dev
# Signs the session tokens. Required: the server refuses to start without it.
# Changing it signs everyone out. Generate one with: openssl rand -base64 32
JWT_SECRET=
# Optional: signs the short-lived cookie of a Discord sign-in. Falls back to JWT_SECRET.
SESSION_SECRET=

# Optional: "Sign in with Discord". Both set, or the button stays hidden.
# Discord developer portal -> your app -> OAuth2: Client ID and Client Secret,
# and add this redirect: <PUBLIC_URL>/colyseus/auth/provider/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: password reset emails through Resend. Both set, or the reset link
# is only written to the server's log. MAIL_FROM must be on a domain verified
# in Resend, e.g. "bagarre <no-reply@your-domain>".
RESEND_API_KEY=
MAIL_FROM=
