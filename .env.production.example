# Production variables for docker-compose.yaml. Copy to .env.production.local
# (git-ignored) for a local run, or fill them in Coolify's environment page.
#
#   docker compose --env-file .env.production.local \
#     -f docker-compose.yaml -f docker-compose.local.yaml up --build

# --- Client build args (public: they end up in the browser bundle) -------------
# Clerk publishable key (pk_test_... while Clerk stays on its dev instance).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# The Convex production deployment (same value as CONVEX_URL).
VITE_CONVEX_URL=https://<prod-deployment>.convex.cloud
# Where the browser finds the game server. A path means "this same origin":
# the client's Caddy proxies it to the server container. Leave as is.
VITE_SERVER_URL=/colyseus

# --- Game server (runtime) -------------------------------------------------------
# Convex production deployment: usernames and match stats.
CONVEX_URL=https://<prod-deployment>.convex.cloud
# Shared with Convex prod (matches.record). Must equal the value set with
#   cd packages/backend && bun run convex env set --prod GAME_SERVER_SECRET=<value>
# Generate one with: openssl rand -hex 32
GAME_SERVER_SECRET=
# Clerk JWT public key (PEM). Keep it on one line with literal \n, in single quotes.
CLERK_JWT_KEY='-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----'
# Clerk Frontend API URL, checked against the tokens' `iss`. Also set in Convex prod.
CLERK_JWT_ISSUER_DOMAIN=https://<instance>.clerk.accounts.dev
# Optional fallback when CLERK_JWT_KEY is unset (verifyToken then fetches the JWKS).
CLERK_SECRET_KEY=
# Optional: allowed `azp` origins of tokens, comma-separated (the public URL).
CLERK_AUTHORIZED_PARTIES=
