# Copy to .env.local (git-ignored) at the repo root. The client (Vite) and the
# game server both read that one file. Every key is optional: with none of
# them, accounts still work in dev (email and password, a local database).

# --- Game server ---------------------------------------------------------------
# Unset: an embedded Postgres (PGlite) in apps/server/.data/pglite, kept across
# restarts (delete the folder to start over). Set: a real Postgres, e.g.
#   DATABASE_URL=postgres://bagarre:bagarre@localhost:5432/bagarre
DATABASE_URL=
# Signs the session tokens. Unset in dev: a fixed dev-only secret.
JWT_SECRET=
# "Sign in with Discord" (both, or the button stays hidden). Create a separate
# dev app in Discord's developer portal with this redirect:
#   http://localhost:2567/auth/provider/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Password reset emails through Resend (both). Unset: the reset link is
# printed in the server's console.
RESEND_API_KEY=
MAIL_FROM=
# Where the reset links point (the client) and the server's own public URL.
# Defaults: http://localhost:5173 and http://localhost:2567.
PUBLIC_URL=
PUBLIC_SERVER_URL=
