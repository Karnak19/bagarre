# Copy to .env.local (git-ignored) at the repo root. The client (Vite), the
# game server and the Convex CLI all read that one file. Every key is optional:
# with none of them the game runs in guest-only mode.

# --- Browser (Vite exposes only VITE_* variables) ---------------------------
# Clerk Dashboard > API keys. Unset: the widget says sign-in isn't configured.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Your Convex deployment URL (same value as CONVEX_URL below).
VITE_CONVEX_URL=https://<deployment>.convex.cloud

# --- Game server ---------------------------------------------------------------
# Clerk token verification. Preferred: the instance's PEM public key, for
# networkless checks (Dashboard > API keys > JWT public key, or convert
# <issuer>/.well-known/jwks.json). Newlines may be written as \n in quotes.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Fallback when CLERK_JWT_KEY is unset: verifyToken fetches the JWKS with it.
CLERK_SECRET_KEY=sk_test_...
# Optional: allowed `azp` origins of tokens, comma-separated (your client URLs).
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Convex deployment the server reads usernames from and writes stats to.
CONVEX_URL=https://<deployment>.convex.cloud
# Shared secret for matches.record. Set the SAME value in Convex:
#   bunx convex env set GAME_SERVER_SECRET=<value>
# Generate one with: openssl rand -hex 32
GAME_SERVER_SECRET=

# --- Convex (set in the Convex deployment, not only here) ----------------------
# Clerk Frontend API URL, used by convex/auth.config.ts (the game server also
# checks tokens' `iss` against it):
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN=https://<instance>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://<instance>.clerk.accounts.dev
# Written by `bunx convex dev` itself on first run.
CONVEX_DEPLOYMENT=
