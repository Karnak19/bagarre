{
  "name": "@bagarre/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p scripts && tsc --noEmit -p bench",
    "lint": "oxlint src scripts bench",
    "maps:validate": "bun scripts/validate.ts",
    "maps:preview": "bun scripts/preview.ts",
    "test": "bun test ./src",
    "bench": "bun bench/physics.bench.ts && bun bench/bots.bench.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
