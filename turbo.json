{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "DISCORD_*", "JWT_SECRET", "MAIL_FROM", "PORT", "PUBLIC_*", "RESEND_API_KEY", "SESSION_SECRET", "VITE_*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.local",
        "$TURBO_ROOT$/.env.production",
        "$TURBO_ROOT$/.env.production.local"
      ],
      "outputs": ["dist/**"]
    },
    "build:bin": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "smoke": {
      "cache": false,
      "passThroughEnv": ["NODE_ENV", "PORT", "SMOKE_PORT"]
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "E2E_GL", "PLAYWRIGHT_*"]
    },
    "maps:validate": {
      "outputs": []
    }
  }
}
