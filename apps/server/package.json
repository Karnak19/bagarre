{
  "name": "@bagarre/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env.local --watch src/index.ts",
    "start": "bun --env-file=../../.env.local src/index.ts",
    "build:bin": "bun build src/index.ts --compile --minify --bytecode --format=esm --outfile dist/bagarre-server",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint src smoke.ts smoke-accounts.ts smoke-ffa.ts",
    "smoke": "bun --env-file=../../.env.local smoke.ts"
  },
  "dependencies": {
    "@bagarre/backend": "workspace:*",
    "@bagarre/shared": "workspace:*",
    "@clerk/backend": "^3.20.1",
    "@colyseus/core": "^0.18.17",
    "@colyseus/schema": "^5.0.34",
    "@colyseus/ws-transport": "^0.18.4",
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@types/node": "^26.6.3",
    "convex-test": "^0.0.60",
    "jose": "^6.2.12",
    "typescript": "^7.0.2"
  }
}
