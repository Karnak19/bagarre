# Plain HTTP on :80. In production Coolify's proxy (Traefik) terminates TLS in
# front of this container, so Caddy must not try to get certificates itself.
{
	auto_https off
	admin off
}

:80 {
	# The game server: HTTP matchmaking, GET /games and the room WebSockets.
	# handle_path strips the /colyseus prefix; reverse_proxy passes WebSocket
	# upgrades through on its own.
	handle_path /colyseus/* {
		reverse_proxy server:2567
	}

	# Vite's hashed bundles never change under the same name. A missing one is
	# a real 404, not the page.
	handle /assets/* {
		root * /srv
		encode zstd gzip
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (index.html, models, sounds) revalidates. SPA fallback:
	# /game/<code> and any other route serve index.html.
	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
