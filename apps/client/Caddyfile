# Plain HTTP on :80. In production Coolify's proxy (Traefik) terminates TLS in
# front of this container, so Caddy must not try to get certificates itself.
{
	auto_https off
	admin off
}

:80 {
	# The game server: HTTP matchmaking, GET /games and the room WebSockets.
	# handle_path strips the /colyseus prefix; reverse_proxy passes WebSocket
	# upgrades through on its own.
	handle_path /colyseus/* {
		reverse_proxy server:2567
	}

	# Vite's hashed bundles never change under the same name. A missing one is
	# a real 404, not the page.
	handle /assets/* {
		root * /srv
		encode zstd gzip
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (the pages, models, sounds, share images) revalidates.
	# Each page has its own copy of index.html with its own title and link
	# preview tags (seo/plugin.ts writes them at build time): /maps/<id> is
	# /maps/<id>.html, /maps is /maps.html, every /game/<code> is the same
	# /game.html and every /game/<code>/watch the same /watch.html (the code is
	# never put in the page). Any other route falls back to index.html (SPA).
	# `route` keeps these rewrites in the order written.
	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		route {
			# One URL per page: /maps/ would otherwise hit the dist/maps/
			# directory (no index.html there) and 404.
			@trailing path_regexp trailing ^(.+)/$
			redir @trailing {re.trailing.1} 308
			@watch path_regexp ^/game/[^/]+/watch/?$
			rewrite @watch /watch.html
			@game path /game/*
			rewrite @game /game.html
			try_files {path} {path}.html /index.html
		}
		file_server
	}
}
